{
  "name": "earshot",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted spatial audio scene designer. Place a sound. Hear it there.",
  "license": "MIT",
  "author": "Joe Crockett",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joecrockett5/earshot.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build -w @earshot/web && npm run build -w @earshot/server",
    "start": "node apps/server/dist/index.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "demo:sounds": "tsx scripts/generate-demo-sounds.ts",
    "brand": "tsx scripts/generate-brand-assets.ts",
    "media": "tsx scripts/media.ts",
    "docker:smoke": "bash scripts/docker-smoke.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.0.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  }
}
